{
  "name": "positivi-tv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:goodsignal": "node --test tests/goodsignal/*.test.mjs",
    "demo:goodsignal": "node scripts/goodsignal-demo.mjs",
    "typecheck:goodsignal": "tsc --project tsconfig.goodsignal.json",
    "test:app": "node --test tests/app/*.test.mjs",
    "editor": "node scripts/editor.mjs",
    "release:check": "node scripts/release-check.mjs",
    "feeds:local": "node scripts/sync-local-feeds.mjs",
    "borders:build": "node scripts/build-borders.mjs",
    "borders:check": "node scripts/build-borders.mjs --check",
    "places:build": "node scripts/build-places.mjs",
    "places:check": "node scripts/build-places.mjs --check",
    "boxes:build": "node scripts/build-country-boxes.mjs",
    "boxes:check": "node scripts/build-country-boxes.mjs --check",
    "facts:build": "node scripts/build-country-facts.mjs --archive",
    "facts:check": "node scripts/build-country-facts.mjs --check --archive",
    "animals:build": "node scripts/build-animal-facts.mjs",
    "animals:check": "node scripts/build-animal-facts.mjs --check"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/global-config": "1.5.1",
    "entities": "8.1.0",
    "fast-xml-parser": "5.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "robots-parser": "3.0.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "^6.0.5",
    "world-atlas": "2.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT"
}
